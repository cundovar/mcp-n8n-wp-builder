      "position": [
        2400,
        0
      ],
      "webhookId": "9e40ba46-b197-4115-833c-059542f34802",
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIAL_ID",
          "name": "SMTP"
        }
      }
    }
  ],
