{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "discovery_brief.schema.json",
  "title": "Discovery Brief",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "stage",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "discovery_brief"
    },
    "payload": {
      "type": "object",
      "required": [
        "objectives",
        "constraints",
        "assumptions"
      ],
      "properties": {
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            },
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "technical": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "business": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "timeline": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "mitigation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
