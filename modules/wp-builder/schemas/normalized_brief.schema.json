{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized_brief.schema.json",
  "title": "Normalized Brief",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "stage",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "normalized_brief"
    },
    "payload": {
      "type": "object",
      "required": [
        "site_name",
        "site_type",
        "objective"
      ],
      "properties": {
        "site_name": {
          "type": "string",
          "minLength": 1
        },
        "site_type": {
          "type": "string",
          "minLength": 1
        },
        "business_domain": {
          "type": "string"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "pages_requested": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "features_requested": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "design_preferences": {
          "type": "object",
          "properties": {
            "style": {
              "type": "string"
            },
            "primary_color": {
              "type": "string"
            },
            "secondary_color": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "target_audience": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
