{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design_plan.schema.json",
  "title": "Design Plan",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "stage",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "design_plan"
    },
    "payload": {
      "type": "object",
      "required": [
        "brand_direction"
      ],
      "properties": {
        "brand_direction": {
          "type": "object",
          "required": ["tone", "palette"],
          "properties": {
            "tone": {
              "type": "string",
              "minLength": 1
            },
            "palette": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "usage": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "type_scale": {
              "type": "object",
              "properties": {
                "base_size": {
                  "type": "string"
                },
                "heading_font": {
                  "type": "string"
                },
                "body_font": {
                  "type": "string"
                },
                "scale_ratio": {
                  "type": "number"
                }
              },
              "additionalProperties": true
            },
            "layout_principles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "component_guidelines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component", "guidelines"],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "guidelines": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": true
        },
        "imagery": {
          "type": "object",
          "properties": {
            "style": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
