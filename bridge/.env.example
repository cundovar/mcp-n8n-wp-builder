# Codex/Claude Bridge Configuration

# Server
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3000

# Authentication (enabled unless explicitly opted out)
# Only BRIDGE_AUTH_ENABLED=false disables it. The server refuses to start when
# auth is on and BRIDGE_TOKEN is unset or still the default dev token.
BRIDGE_AUTH_ENABLED=false
BRIDGE_TOKEN=your-secret-token-here

# Root directory the AI tasks are confined to. Any cwd sent to the API is
# resolved and rejected if it escapes this root. Defaults to process.cwd().
WORKSPACE_ROOT=/workspace

# CLI Commands (if not in PATH)
CODEX_CMD=codex
CLAUDE_CMD=claude

# Limits
MAX_CONCURRENT_JOBS=2
MAX_INPUT_SIZE=100000
MAX_OUTPUT_SIZE=500000

# Logging
LOG_LEVEL=info
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wp-builder

# n8n Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/wp-site-builder
