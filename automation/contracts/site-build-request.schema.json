{
  "$id": "https://mcp-n8n-wp-builder/schemas/site-build-request.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Site Build Request",
  "description": "Canonical contract submitted to the intake workflow (phase 1). The structured JSON is the source of truth; any human-readable brief is generated from it, never the other way around.",
  "type": "object",
  "required": ["contract_version", "request_id", "business", "site", "execution_mode", "approved_artifact_versions", "target_site", "kit_selection", "constraints"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0",
      "description": "Unknown or unsupported versions must be rejected by the intake workflow, not coerced."
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "business": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "coordinates": {
          "type": "object",
          "description": "Contact/location details. Missing fields here are a common source of needs_input.",
          "additionalProperties": false,
          "properties": {
            "phone": { "type": "string" },
            "email": { "type": "string" },
            "address": { "type": "string" },
            "service_area": { "type": "string" }
          }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": { "type": "string" },
        "pages": { "type": "array", "items": { "type": "string" } },
        "features": { "type": "array", "items": { "type": "string" } },
        "design_preferences": { "type": "string" },
        "target_audience": { "type": "string" }
      }
    },
    "execution_mode": {
      "type": "string",
      "enum": ["dry_run", "apply"],
      "default": "dry_run"
    },
    "approved_artifact_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_architecture", "content_plan", "design_plan", "wordpress_plan", "execution_plan"],
      "properties": {
        "site_architecture": { "type": "integer", "minimum": 1 },
        "content_plan": { "type": "integer", "minimum": 1 },
        "design_plan": { "type": "integer", "minimum": 1 },
        "wordpress_plan": { "type": "integer", "minimum": 1 },
        "execution_plan": { "type": "integer", "minimum": 1 }
      }
    },
    "target_site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id"],
      "properties": {
        "site_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$" }
      }
    },
    "kit_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "kit_id"],
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "manual"] },
        "kit_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "builder", "elementor_level", "woocommerce", "publish"],
      "properties": {
        "theme": { "const": "astra" },
        "builder": { "const": "elementor" },
        "elementor_level": { "type": "string", "enum": ["free", "pro"] },
        "woocommerce": { "type": "boolean" },
        "publish": { "const": false }
      }
    },
    "stage_artifacts": {
      "type": "object",
      "description": "Opaque bag populated by phases 2-4 (infrastructure result, build manifest, review result). Empty at intake time.",
      "additionalProperties": true
    },
    "missing_information": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Field paths (e.g. business.coordinates.phone) the intake workflow found missing or unusable."
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "mitigated": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
