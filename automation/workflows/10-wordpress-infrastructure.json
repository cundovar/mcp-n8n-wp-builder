          "jsCode": "const requestId = $('Infrastructure Trigger Webhook').first().json.body.request_id;\nconst actions = $('Parse Proposed Actions').first().json.actions;\nconst validation = $json.results || [];\nconst violations = validation.filter(r => !r.ok);\nconst allValid = violations.length === 0 && validation.length === actions.length;\nreturn [{ json: { request_id: requestId, actions, validation, violations, all_valid: allValid } }];"
