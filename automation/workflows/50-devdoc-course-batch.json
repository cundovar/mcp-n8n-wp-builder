        "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "leftValue": "={{ $json.data.status }}", "rightValue": "succeeded", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "options": {} },
