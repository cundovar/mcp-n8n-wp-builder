        "position": [-1320, -80],
        "id": "devdoc-0002"
      },
      {
        "parameters": { "jsCode": "const input = $json.body ?? $json;\nif (!input.superMenu || !input.category || !Array.isArray(input.menus)) throw new Error('superMenu, category and menus are required');\nconst seen = new Set();\nlet count = 0;\nfor (const menu of input.menus) {\n  for (const course of (menu.courses || [])) {\n    const externalId = String(course.externalId || '').trim();\n    if (!externalId || seen.has(externalId)) throw new Error('Every course needs a unique externalId');\n    seen.add(externalId);\n    count += 1;\n  }\n}\nif (!count) throw new Error('No course supplied');\nreturn [{ json: { batchId: input.batchId || `devdoc-${$execution.id}`, superMenu: input.superMenu, category: input.category, menus: input.menus } }];" },
        "name": "Validate and Flatten Batch",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-1080, 100],
        "id": "devdoc-0003"
      },
      {
        "parameters": { "method": "POST", "url": "={{ $env.DEVDOC_MCP_URL + '/api/orchestration/formations/preparer' }}", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $env.DEVDOC_MCP_TOKEN }}" }, { "name": "Content-Type", "value": "application/json" }] }, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ superMenu: $json.superMenu, category: $json.category, menus: $json.menus }) }}", "options": {} },
        "name": "Prepare Formation",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [-840, 100],
        "id": "devdoc-0004",
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 1000
      },
      {
        "parameters": { "jsCode": "const source = $('Validate and Flatten Batch').first().json;\nconst prepared = $json.data;\nconst key = (name, level) => `${String(name || 'Cours').trim().toLowerCase()}::${String(level || '').trim().toLowerCase()}`;\nconst menuIds = new Map(prepared.menus.map((menu) => [key(menu.label, menu.niveauCoursName), menu.id]));\nconst rows = [];\nfor (const menu of source.menus) {\n  for (const course of (menu.courses || [])) {\n    const level = menu.level || course.level;\n    const menuId = menuIds.get(key(menu.name || 'Cours', level));\n    if (!menuId) throw new Error(`Prepared menu not found: ${menu.name || 'Cours'}`);\n    rows.push({ json: { batchId: source.batchId, category: source.category, level, menuId, course } });\n  }\n}\nreturn rows;" },
        "name": "Expand Courses",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-720, 100],
        "id": "devdoc-0018"
      },
