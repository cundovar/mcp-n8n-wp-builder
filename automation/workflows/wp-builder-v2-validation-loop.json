          "jsCode": "const input = $json.body ?? $json;\nconst requestId = input.requestId || input.request_id;\nconst artifactType = input.artifact_type || input.target_artifact;\nconst artifactVersion = Number(input.artifact_version || input.target_version);\nconst decision = String(input.decision || '').trim();\n  const bridgeBaseUrl = String(input.bridge_base_url || input.bridgeBaseUrl || 'http://mcp-bridge:3000').trim();\n  const n8nBaseUrl = String(input.n8n_base_url || input.n8nBaseUrl || 'http://n8n:5678').trim();\nconst createdBy = String(input.created_by || input.user_id || input.user || 'human-validator').trim();\nconst comment = String(input.comment || '').trim();\nconst requestedChanges = Array.isArray(input.requested_changes)\n  ? input.requested_changes.map((item) => String(item).trim()).filter(Boolean)\n  : typeof input.requested_changes === 'string'\n    ? input.requested_changes.split('\\n').map((item) => item.trim()).filter(Boolean)\n    : [];\n\nif (!requestId) throw new Error('Missing requestId');\nif (!artifactType) throw new Error('Missing artifact_type');\nif (!Number.isInteger(artifactVersion) || artifactVersion < 1) throw new Error('Invalid artifact_version');\nif (!['approved', 'changes_requested', 'rejected'].includes(decision)) throw new Error('Invalid decision');\n\nreturn [{ json: {\n  request_id: requestId,\n  artifact_type: artifactType,\n  artifact_version: artifactVersion,\n  decision,\n  comment,\n  requested_changes: requestedChanges,\n  created_by: createdBy,\n  bridge_base_url: bridgeBaseUrl.replace(/\\/$/, ''),\n  n8n_base_url: n8nBaseUrl.replace(/\\/$/, '')\n} }];"
